# Copy values into a gitignored .env or provide them through Docker secrets.
# Never put real tokens in this file.
#
# Defaults below describe an AIGate deployment: one host, one token. AIGate
# keeps Talkies on its private network with no host port binding and exposes it
# at /talkies/, so both URLs point at the gateway. Because they share a host and
# port, the AIGate token is reused for Talkies automatically.
TWOXBRAINZ_AIGATE_URL=http://aigate:4000/v1
TWOXBRAINZ_AIGATE_MODEL=your-configured-model
TWOXBRAINZ_AIGATE_TOKEN=REPLACE_ME
TWOXBRAINZ_TALKIES_WS_URL=ws://aigate:4000/talkies/v1/audio/transcriptions/stream
TWOXBRAINZ_TALKIES_MODEL=nemotron-3.5-asr-0.6b

# Standalone Talkies, with text generation somewhere else entirely -- swap the
# two URLs above for a pair like this and set the token below. Different host,
# so nothing is shared: the AIGate token is never sent to Talkies, and the
# Talkies token is never sent to the text provider.
#
#   TWOXBRAINZ_AIGATE_URL=https://api.openai.com/v1     # or Groq: https://api.groq.com/openai/v1
#   TWOXBRAINZ_TALKIES_WS_URL=ws://talkies:8000/v1/audio/transcriptions/stream
#   TWOXBRAINZ_TALKIES_TOKEN=REPLACE_ME
#
# The URL is the OpenAI-compatible API root and must include the version prefix
# the provider serves -- /v1 for AIGate, OpenAI and Groq.

TWOXBRAINZ_AIGATE_MODE=local
# Set mode=remote and this value=true only when transcript text may leave the machine.
TWOXBRAINZ_REMOTE_TEXT_ENABLED=false
TWOXBRAINZ_LOG_LEVEL=INFO
TWOXBRAINZ_LOG_FILE=/tmp/2xbrainz.log
