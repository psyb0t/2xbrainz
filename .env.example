# Copy values into a gitignored .env or provide them through Docker secrets.
# Never put real tokens in this file.
#
# 2xbrainz talks only to AIGate. AIGate must have Talkies enabled and serves its
# private Talkies service at /talkies/. The application derives that WebSocket
# URL and uses this one bearer token for ASR, model inventory, and LLM requests.
#
# Joining a specific Docker network instead (LIVE_NETWORK=<name>) means swapping
# localhost for the gateway's service name, e.g. http://aigate:4000/v1.
TWOXBRAINZ_AIGATE_URL=http://localhost:4000/v1
TWOXBRAINZ_AIGATE_TOKEN=REPLACE_ME

# Models, reasoning effort, call context, research, and audio sources are safe
# runtime settings configured in the web UI and stored in that browser. Built-in
# defaults are used until the browser sends an override.
TWOXBRAINZ_LOG_LEVEL=INFO
# `make run` overrides this to its mounted /logs directory. Direct Docker users
# can mount a host directory at this absolute path. Each live session receives a
# separate UTC-prefixed rotating file there. It wins over LOG_FILE.
TWOXBRAINZ_LOG_DIRECTORY=/logs
