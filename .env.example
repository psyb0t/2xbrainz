# Copy values into a gitignored .env or provide them through Docker secrets.
# Never put real tokens in this file.
#
# 2xbrainz talks only to AIGate. AIGate must have Talkies enabled and serves its
# private Talkies service at /talkies/. The application derives that WebSocket
# URL and uses this one bearer token for ASR, model inventory, and LLM requests.
#
# Joining a specific Docker network instead (LIVE_NETWORK=<name>) means swapping
# localhost for the gateway's service name, e.g. http://aigate:4000/v1.
TWOXBRAINZ_AIGATE_URL=http://localhost:4000/v1
# Legacy fallback used for any first-run flow without an explicit model below.
TWOXBRAINZ_AIGATE_MODEL=your-configured-model
# Reply owns research and arithmetic tools, so use a fast model with reliable
# tool calling. Coach and Story can use cheaper text-only models. Browser-saved
# assignments replace these first-run values on later starts.
TWOXBRAINZ_AIGATE_REPLY_MODEL=your-fast-tool-capable-model
TWOXBRAINZ_AIGATE_COACH_MODEL=your-coaching-model
TWOXBRAINZ_AIGATE_SUMMARY_MODEL=your-summary-model
# Legacy fallback for any flow without a dedicated effort below. Values are
# none, minimal, low, medium, or high. The browser saves and restores each
# model/effort pair independently. Unsupported combinations are reported by
# AIGate.
TWOXBRAINZ_AIGATE_REASONING_EFFORT=none
TWOXBRAINZ_AIGATE_REPLY_REASONING_EFFORT=none
TWOXBRAINZ_AIGATE_COACH_REASONING_EFFORT=none
TWOXBRAINZ_AIGATE_SUMMARY_REASONING_EFFORT=none
TWOXBRAINZ_AIGATE_TOKEN=REPLACE_ME
TWOXBRAINZ_TALKIES_MODEL=nemotron-3.5-asr-0.6b

# Optional trusted local context that frames every reply, private coaching note,
# and running summary, for example the purpose and role of the upcoming call.
# Keep it under 4000 characters. It is not printed by `doctor` or written to logs.
TWOXBRAINZ_SESSION_BRIEF=

# When true, reply drafts may search through AIGate's SearXNG MCP tool, read a
# specific public result page through the application's bounded page reader, and
# run bounded numeric arithmetic through Piston. Search queries leave the machine;
# obvious structured private identifiers are rejected before the call. Requires
# AIGate with SEARXNG=1 (plus PISTON=1 for arithmetic). Commentary and the running
# summary stay transcript-only.
TWOXBRAINZ_WEB_RESEARCH_ENABLED=false
TWOXBRAINZ_LOG_LEVEL=INFO
# `make run` overrides this to its mounted /logs directory. Direct Docker users
# can mount a host directory at this absolute path. Each live session receives a
# separate UTC-prefixed rotating file there. It wins over LOG_FILE.
TWOXBRAINZ_LOG_DIRECTORY=/logs

# `make run` mounts this absolute in-container path to the host's
# $XDG_CONFIG_HOME/2xbrainz (or ~/.config/2xbrainz) directory. It contains only
# the selected PipeWire node names, is mode 0600, and is not a secret.
TWOXBRAINZ_AUDIO_CONFIG_FILE=/audio-config/audio-selection.json
